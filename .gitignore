# Dependencies
node_modules/
frontend/node_modules/
server/node_modules/

# Build outputs
frontend/out/
# Pas frontend/build/ : pour electron-builder c'est le dossier des ressources
# SOURCES (buildResources) — icônes, installer.nsh, after-pack.cjs — et non une
# sortie. Ignoré, il n'avait jamais été versionné : un clone propre produisait
# un exe sans icône ni garde-fou Windows 7/8, et le build échouait sur le hook.
frontend/dist/
frontend/release/
server/dist/
server/build/

# Environment variables
.env
.env.local
.env.*.local
frontend/.env
server/.env

# Storage local (fichiers uploadés, pas de service tiers)
server/storage/

# Base de données locale SQLite (client offline)
*.sqlite
*.sqlite-journal
*.sqlite3
*.db

# Prisma
server/prisma/migrations/dev/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Electron
frontend/out/
frontend/dist/
frontend/release/

# Docker volumes
postgres_data/

# Editor / OS
.DS_Store
Thumbs.db
*.swp
*.swo

# IDE (optionnel - certaines équipes préfèrent versionner .vscode)
.idea/
*.iml

# Coverage / tests
coverage/
.nyc_output/

# TypeScript build info
*.tsbuildinfo

# Local Netlify folder
.netlify
