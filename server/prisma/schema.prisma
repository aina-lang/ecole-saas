generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                 String              @id @default(cuid())
  name               String
  logoUrl            String?
  primaryColor       String              @default("#2563eb")
  plan               SubscriptionPlan    @default(FREE)
  status             TenantStatus        @default(TRIAL)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  trialEndsAt        DateTime?
  suspendedAt        DateTime?
  maxStudents        Int                 @default(100)
  maxTeachers        Int                 @default(20)
  maxStorageMb       Int                 @default(500)
  settings           Json                @default("{}")
  /// Identifiants CouchDB propres à ce tenant (créés à la demande), restreints
  /// à ses propres bases via un document _security — jamais un compte admin
  /// global partagé entre tous les tenants. Mot de passe chiffré (AES-256-GCM).
  couchDbUser        String?
  couchDbPasswordEnc String?
  /// Code de la licence active (cf. model License). Nul pendant l'essai.
  licenseKey           String?
  currentPeriodEnd     DateTime?
  academicYears      AcademicYear[]
  attendances        Attendance[]
  auditLogs          AuditLog[]
  classes            Class[]
  documents          Document[]
  feeStructures      FeeStructure[]
  grades             Grade[]
  levels             Level[]
  messages           Message[]
  payments           Payment[]
  studentEnrollments StudentEnrollment[]
  studentDocuments   StudentDocument[]
  gradeConfig        GradeConfig?
  tenantSettings     TenantSetting[]
  licenses           License[]
  students           Student[]
  subjects           Subject[]
  syncDevices        SyncDevice[]
  syncJobs           SyncJob[]
  syncLogs           SyncLog[]
  teacherAttendances TeacherAttendance[]
  teacherContracts   TeacherContract[]
  teacherPayments    TeacherPayment[]
  teachers           Teacher[]
  timetableSlots     TimetableSlot[]
  users              User[]

  @@map("tenants")
}

model Level {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  sortOrder Int      @default(0)
  nextLevelId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nextLevel     Level?         @relation("LevelHierarchy", fields: [nextLevelId], references: [id])
  previousLevel Level[]        @relation("LevelHierarchy")
  classes       Class[]
  feeStructures FeeStructure[]
  enrollments   StudentEnrollment[]
  subjects      Subject[]

  @@unique([tenantId, name])
  @@map("levels")
}

model AcademicYear {
  id          String      @id @default(cuid())
  tenantId    String
  label       String
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean     @default(false)
  payments    Payment[]
  enrollments StudentEnrollment[]
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  holidays    Holiday[]
  periods     Period[]
  grades      Grade[]
  attendances Attendance[]

  @@unique([tenantId, label])
  @@map("academic_years")
}

model Period {
  id             String       @id @default(cuid())
  academicYearId String
  label          String
  type           PeriodType   @default(TRIMESTER)
  startDate      DateTime
  endDate        DateTime
  coefficient    Float        @default(1.0)
  grades         Grade[]
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@map("periods")
}

model Holiday {
  id             String       @id @default(cuid())
  academicYearId String
  label          String
  startDate      DateTime
  endDate        DateTime
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  @@map("holidays")
}

model User {
  id               String             @id @default(cuid())
  tenantId         String
  email            String
  passwordHash     String
  firstName        String?
  lastName         String
  role             UserRole           @default(TEACHER)
  isActive         Boolean            @default(true)
  twoFactorSecret  String?
  twoFactorEnabled Boolean            @default(false)
  lastLoginAt      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  refreshToken     String?
  photoUrl         String?
  /// Mot de passe temporaire remis par le support : changement forcé à la connexion.
  mustChangePassword     Boolean   @default(false)
  /// Hash SHA-256 du jeton de réinitialisation envoyé par e-mail (usage unique).
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  auditLogs        AuditLog[]
  messagesReceived MessageRecipient[]
  messagesSent     Message[]          @relation("sentMessages")
  studentLinks     StudentParent[]    @relation("parentLinks")
  teacher          Teacher?
  phones           UserPhone[]
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@map("users")
}

model UserPhone {
  id        String @id @default(cuid())
  userId    String
  value     String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, value])
  @@map("user_phones")
}

model Student {
  id                 String          @id @default(cuid())
  tenantId           String
  registrationNumber String
  firstName          String?
  lastName           String
  birthDate          DateTime?
  birthPlace         String?
  gender             String?
  nationality        String?
  address            String?
  phoneNumber        String?
  email              String?
  photoUrl           String?
  bloodType          String?
  medicalNotes       String?
  allergies          String?
  emergencyContact   String?
  emergencyPhone     String?
  status             StudentStatus   @default(ACTIVE)
  classId            String?
  enrollmentDate     DateTime        @default(now())
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?
  version            Int             @default(1)
  updatedBy          String?
  deviceId           String?
  attendances        Attendance[]
  documents          Document[]
  studentDocuments   StudentDocument[]
  grades             Grade[]
  payments           Payment[]
  parents            StudentParent[] @relation("studentParents")
  enrollments        StudentEnrollment[]
  class              Class?          @relation(fields: [classId], references: [id])
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Unicité PAR ÉTABLISSEMENT : deux écoles peuvent avoir le même matricule,
  // et la numérotation d'un tenant ne dépend plus de celle des autres.
  @@unique([tenantId, registrationNumber])
  @@map("students")
}

model StudentEnrollment {
  id                  String              @id @default(cuid())
  tenantId            String
  studentId           String
  academicYearId      String
  levelId             String
  classId             String?
  promotionDecision   PromotionDecision?
  reinscriptionStatus ReinscriptionStatus @default(PRE_INSCRIT)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  student      Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  academicYear AcademicYear  @relation(fields: [academicYearId], references: [id])
  level        Level         @relation(fields: [levelId], references: [id])
  class        Class?        @relation(fields: [classId], references: [id])
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, academicYearId])
  @@index([tenantId, academicYearId])
  @@index([tenantId, levelId])
  @@map("student_enrollments")
}

model StudentParent {
  id        String  @id @default(cuid())
  studentId String
  parentId  String
  relation  String?
  isPrimary Boolean @default(false)
  parent    User    @relation("parentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation("studentParents", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, parentId])
  @@map("student_parents")
}

model Class {
  id             String          @id @default(cuid())
  tenantId       String
  name           String
  level          String?
  levelId        String?
  room           String?
  capacity       Int             @default(30)
  deletedAt      DateTime?
  version        Int             @default(1)
  updatedBy      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelRel       Level?          @relation(fields: [levelId], references: [id])
  students       Student[]
  enrollments    StudentEnrollment[]
  timetableSlots TimetableSlot[]
  attendances    Attendance[]
  teachers       Teacher[]       @relation("ClassToTeacher")

  @@unique([tenantId, name])
  @@map("classes")
}

model Subject {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  code        String?
  coefficient Float           @default(1.0)
  level       String?
  levelId     String?
  deletedAt   DateTime?
  version     Int             @default(1)
  updatedBy   String?
  grades      Grade[]
  attendances Attendance[]
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelRel    Level?          @relation(fields: [levelId], references: [id])
  timetable   TimetableSlot[]
  teachers    Teacher[]       @relation("SubjectToTeacher")

  @@unique([tenantId, name, level])
  @@map("subjects")
}

model Teacher {
  id          String              @id @default(cuid())
  tenantId    String
  userId      String              @unique
  specialty   String?
  grades              Grade[]
  attendances         TeacherAttendance[]
  studentAttendances  Attendance[]
  contract            TeacherContract?
  payments            TeacherPayment[]
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  timetable           TimetableSlot[]
  classes             Class[]             @relation("ClassToTeacher")
  subjects            Subject[]           @relation("SubjectToTeacher")

  @@map("teachers")
}

model TimetableSlot {
  id        String   @id @default(cuid())
  tenantId  String
  classId   String
  // Optionnel : un créneau peut être posé sans matière (pause, à définir).
  subjectId String?
  teacherId String?
  dayOfWeek Int      @default(1)
  startTime String
  endTime   String
  /// Récréation / pause (pas un cours) — les postes la gèrent depuis toujours,
  /// la colonne manquait en base : l’API renvoyait les pauses comme des cours.
  isRecreation   Boolean   @default(false)
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject     Subject?     @relation(fields: [subjectId], references: [id], onDelete: SetNull)
  teacher     Teacher?     @relation(fields: [teacherId], references: [id])
  attendances Attendance[]
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, startTime])
  @@index([tenantId, classId])
  @@map("timetable_slots")
}

model TeacherAttendance {
  id            String                  @id @default(cuid())
  tenantId      String
  teacherId     String
  date          DateTime
  status        TeacherAttendanceStatus @default(PRESENT)
  justification String?
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  teacher       Teacher                 @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant        Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([teacherId, date])
  @@index([tenantId, date])
  @@map("teacher_attendances")
}

model TeacherContract {
  id            String       @id @default(cuid())
  tenantId      String
  teacherId     String       @unique
  contractType  ContractType @default(HOURLY)
  hourlyRate    Float?
  monthlySalary Float?
  fixedAmount   Float?
  /// Numéro d'immatriculation CNaPS (Caisse Nationale de Prévoyance Sociale) —
  /// obligatoire pour tout contrat de travail légal à Madagascar.
  cnapsNumber   String?
  /// Numéro d'affiliation OSTIE (assurance maladie) — idem, requis pour la paie.
  ostieNumber   String?
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  teacher       Teacher      @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant        Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("teacher_contracts")
}

model TeacherPayment {
  id              String               @id @default(cuid())
  tenantId        String
  teacherId       String
  periodLabel     String
  periodStart     DateTime
  periodEnd       DateTime
  totalHours      Float                @default(0)
  hourlyRate      Float?
  baseAmount      Float                @default(0)
  bonusAmount     Float                @default(0)
  deductionAmount Float                @default(0)
  totalAmount     Float                @default(0)
  status          TeacherPaymentStatus @default(PENDING)
  paidAt          DateTime?
  paymentMethod   String?
  reference       String?
  notes           String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  teacher         Teacher              @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  tenant          Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, teacherId])
  @@map("teacher_payments")
}

model Grade {
  id              String        @id @default(cuid())
  tenantId        String
  academicYearId  String?
  studentId       String
  subjectId       String
  teacherId       String?
  periodId        String?
  value           Float
  maxValue        Float         @default(20.0)
  coefficient     Float         @default(1.0)
  evaluationType  EvaluationType @default(EXAM)
  evaluationLabel String?
  comment         String?
  isPublished     Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deletedAt       DateTime?
  version         Int           @default(1)
  updatedBy       String?
  deviceId        String?
  academicYear    AcademicYear? @relation(fields: [academicYearId], references: [id])
  period          Period?       @relation(fields: [periodId], references: [id])
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject         Subject       @relation(fields: [subjectId], references: [id])
  teacher         Teacher?      @relation(fields: [teacherId], references: [id])
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("grades")
}

model Attendance {
  id              String           @id @default(cuid())
  tenantId        String
  academicYearId  String?
  studentId       String
  classId         String?
  date            DateTime
  halfDay         HalfDay?
  timetableSlotId String?
  subjectId       String?
  teacherId       String?
  status          AttendanceStatus @default(PRESENT)
  justification   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  version         Int              @default(1)
  updatedBy       String?
  deviceId        String?
  academicYear    AcademicYear?    @relation(fields: [academicYearId], references: [id])
  student         Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class           Class?           @relation(fields: [classId], references: [id])
  timetableSlot   TimetableSlot?   @relation(fields: [timetableSlotId], references: [id])
  subject         Subject?         @relation(fields: [subjectId], references: [id])
  teacher         Teacher?         @relation(fields: [teacherId], references: [id])
  tenant          Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, halfDay])
  @@unique([studentId, date, timetableSlotId])
  @@index([tenantId, classId, date])
  @@index([tenantId, date])
  @@map("attendances")
}

enum HalfDay {
  MORNING
  AFTERNOON
}

enum FeeType {
  TUITION
  ANNUAL
  OTHER
}

model FeeStructure {
  id          String    @id @default(cuid())
  tenantId    String
  levelId     String?
  label       String
  feeType     FeeType   @default(TUITION)
  amount      Float
  dueDay      Int       @default(15)
  description String?
  isActive    Boolean   @default(true)
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level       Level?    @relation(fields: [levelId], references: [id])
  payments    Payment[]

  @@map("fee_structures")
}

model Payment {
  id             String        @id @default(cuid())
  tenantId       String
  academicYearId String?
  studentId      String
  feeStructureId String?
  amount         Float
  paidAmount     Float         @default(0)
  dueDate        DateTime
  paidAt         DateTime?
  status         PaymentStatus @default(PENDING)
  paymentMethod  String?
  reference      String?
  receiptNumber  String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?
  version        Int           @default(1)
  updatedBy      String?
  deviceId       String?
  academicYear   AcademicYear? @relation(fields: [academicYearId], references: [id])
  feeStructure   FeeStructure? @relation(fields: [feeStructureId], references: [id])
  student        Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Pièce comptable : un numéro de reçu ne doit exister qu'une fois par
  // établissement (NULL multiples autorisés par PostgreSQL).
  @@unique([tenantId, receiptNumber])
  @@map("payments")
}

model Message {
  id         String             @id @default(cuid())
  tenantId   String
  senderId   String
  subject    String
  body       String
  priority   MessagePriority    @default(NORMAL)
  status     MessageStatus      @default(SENT)
  createdAt  DateTime           @default(now())
  documents  Document[]
  recipients MessageRecipient[]
  sender     User               @relation("sentMessages", fields: [senderId], references: [id])
  tenant     Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model MessageRecipient {
  id        String        @id @default(cuid())
  messageId String
  userId    String
  status    MessageStatus @default(SENT)
  readAt    DateTime?
  createdAt DateTime      @default(now())
  message   Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id])

  @@unique([messageId, userId])
  @@map("message_recipients")
}

model Document {
  id           String           @id @default(cuid())
  tenantId     String
  studentId    String?
  messageId    String?
  category     DocumentCategory @default(OTHER)
  fileName     String
  originalName String
  mimeType     String
  size         Int
  path         String
  uploadedBy   String
  createdAt    DateTime         @default(now())
  deletedAt    DateTime?
  message      Message?         @relation(fields: [messageId], references: [id])
  student      Student?         @relation(fields: [studentId], references: [id])
  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  entityType String
  entityId   String?
  oldValue   Json?
  newValue   Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([tenantId, userId])
  @@index([tenantId, entityType, entityId])
  @@map("audit_logs")
}

model SyncDevice {
  id                String    @id @default(cuid())
  tenantId          String
  deviceId          String    @unique
  deviceName        String?
  lastSyncAt        DateTime?
  lastSyncTimestamp DateTime?
  createdAt         DateTime  @default(now())
  tenant            Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  syncLogs          SyncLog[]

  @@unique([tenantId, deviceId])
  @@map("sync_devices")
}

model SyncLog {
  id            String        @id @default(cuid())
  tenantId      String
  deviceId      String
  entityType    String
  entityId      String
  operation     SyncOperation
  payload       Json
  status        SyncStatus    @default(PENDING)
  errorMessage  String?
  serverVersion Int?
  conflictData  Json?
  createdAt     DateTime      @default(now())
  syncedAt      DateTime?
  syncDevice    SyncDevice    @relation(fields: [deviceId], references: [deviceId])
  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sync_logs")
}

model SyncJob {
  id          String        @id @default(cuid())
  tenantId    String
  jobType     String
  payload     Json
  status      SyncJobStatus @default(PENDING)
  priority    Int           @default(0)
  retryCount  Int           @default(0)
  createdAt   DateTime      @default(now())
  processedAt DateTime?
  error       String?
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("sync_jobs")
}

enum SubscriptionPlan {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
  TRIAL
  /// Essai expiré ou paiement Stripe en échec — accès en lecture seule
  /// (aucune création/modification/suppression) jusqu'à régularisation.
  PAST_DUE
  CANCELLED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  TEACHER
  SECRETARY
  PARENT
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  ERROR
}

enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
  HOLIDAY
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  REFUNDED
}

enum MessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum MessageStatus {
  DRAFT
  SENT
  DELIVERED
  READ
  ARCHIVED
}

enum DocumentCategory {
  ADMINISTRATIVE
  MEDICAL
  PEDAGOGICAL
  FINANCIAL
  OTHER
}

enum TeacherAttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ContractType {
  HOURLY
  MONTHLY
  FIXED
}

enum TeacherPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

enum PromotionDecision {
  ADMIS
  REDOUBLANT
  EXCLU
  A_DELIBERER
}

enum ReinscriptionStatus {
  PRE_INSCRIT
  BLOQUE
  INSCRIT_ACTIF
}

enum PeriodType {
  TRIMESTER
  SEMESTER
  BIMESTER
}

enum EvaluationType {
  EXAM
  TEST
  HOMEWORK
  ORAL
  PROJECT
  CONTROLE
  EXAMEN_BLANC
}

enum SyncJobStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  ERROR
}

// Clé de licence courte (16 caractères, affichée XXXX-XXXX-XXXX-XXXX), émise
// par l'éditeur pour un établissement (identifié par l'e-mail de son admin)
// et vérifiée par le serveur à l'activation. Annuelle, sans quota.
model License {
  id          String    @id @default(cuid())
  code        String    @unique
  tenantId    String
  email       String
  issuedAt    DateTime  @default(now())
  expiresAt   DateTime
  activatedAt DateTime?
  revokedAt   DateTime?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("licenses")
}

// Configuration du calcul des moyennes (types d'évaluation inclus...).
// Écrite uniquement par le client (GradeAveragingConfig.tsx) avec l'_id fixe
// "grade_config" dans la base PouchDB du tenant ; côté Postgres le worker la
// range sous l'id "<tenantId>_grade_config" et l'unicité porte sur tenantId.
model GradeConfig {
  id                String   @id
  tenantId          String   @unique
  includedTypes     String[] @default([])
  examBlancIsolated Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  tenant            Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("grade_configs")
}

// Réglages d'établissement partagés entre postes (nom/logo de l'école, année
// scolaire, système de périodes, config de paiement...) — remplace le
// settings.json local à chaque poste, qui laissait le poste B sans logo ni
// périodes. L'_id client est la clé ("school", "academic_year"...), fixe dans
// chaque base tenant ; côté Postgres l'id est "<tenantId>_<clé>" et l'upsert
// du worker porte sur l'unicité (tenantId, key).
model TenantSetting {
  id        String   @id
  tenantId  String
  key       String
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@map("tenant_settings")
}

// Pièces jointes du dossier élève (onglet Documents de la fiche élève).
// fileData contient pour l'instant une data URL base64 — à migrer vers des
// _attachments CouchDB quand la propagation des fichiers sera traitée.
model StudentDocument {
  id               String    @id
  tenantId         String
  studentId        String
  fileName         String
  notes            String?
  fileData         String?
  fileMimeType     String?
  fileOriginalName String?
  fileSize         Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  deletedAt        DateTime?
  student          Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tenant           Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, studentId])
  @@map("student_documents")
}
