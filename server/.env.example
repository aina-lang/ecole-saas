DATABASE_URL="postgresql://user:password@localhost:5432/ecole_saas?schema=public"
JWT_SECRET="change-me-to-a-random-string"
JWT_REFRESH_SECRET="change-me-to-another-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
STORAGE_PATH="./storage"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

COUCHDB_URL="http://localhost:5984"
# Compte ADMIN CouchDB — reste côté serveur, ne quitte jamais l'API. Sert
# uniquement à provisionner un utilisateur par tenant à la volée (voir
# CouchDbService.ensureTenantProvisioned). N'est plus jamais renvoyé au client.
COUCHDB_USER=""
COUCHDB_PASS=""

# Optionnel : clé dédiée au chiffrement des identifiants CouchDB par tenant
# stockés en base (Tenant.couchDbPasswordEnc). Si absent, JWT_SECRET est réutilisé.
# CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-random-string"

FRONTEND_URL="http://localhost:5173"

# Abonnement Stripe = une licence unique (pas de paliers). Clé secrète + secret
# de signature webhook (Dashboard Stripe > Developers > Webhooks, ou
# `stripe listen` en local) + le Price ID du produit "Licence" créé côté
# Stripe (mode Test d'abord).
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_LICENSE=""
