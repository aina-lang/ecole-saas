DATABASE_URL="postgresql://user:password@localhost:5432/ecole_saas?schema=public"
JWT_SECRET="change-me-to-a-random-string"
JWT_REFRESH_SECRET="change-me-to-another-random-string"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
STORAGE_PATH="./storage"
PORT=3000
CORS_ORIGIN="http://localhost:5173"

COUCHDB_URL="http://localhost:5984"
# Compte ADMIN CouchDB — reste côté serveur, ne quitte jamais l'API. Sert
# uniquement à provisionner un utilisateur par tenant à la volée (voir
# CouchDbService.ensureTenantProvisioned). N'est plus jamais renvoyé au client.
COUCHDB_USER=""
COUCHDB_PASS=""

# Optionnel : clé dédiée au chiffrement des identifiants CouchDB par tenant
# stockés en base (Tenant.couchDbPasswordEnc). Si absent, JWT_SECRET est réutilisé.
# CREDENTIALS_ENCRYPTION_KEY="change-me-to-a-random-string"

FRONTEND_URL="http://localhost:5173"

# Licences : codes courts (XXXX-XXXX-XXXX-XXXX) stockés en base, émis par
#   npm run license:issue -- --email <admin@ecole.mg>   (annuelle, illimitée)
# Aucune clé cryptographique à configurer.

# E-mails transactionnels (mot de passe oublié). Gmail : mot de passe d'application.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="merciaaina@gmail.com"
SMTP_PASS=""
MAIL_FROM="Sekoliko <merciaaina@gmail.com>"
